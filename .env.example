# AI Video Editor - Environment Variables Template
#
# Copy this file to .env and customize values for your environment.
# Or set these as system environment variables (Windows: [Environment]::SetEnvironmentVariable("...", "..."))
#
# All variables are OPTIONAL. The app will use sensible defaults if not set.

# === Cache Configuration ===

# Where the app stores user data, cache, preferences, imported videos, thumbnails, etc.
# Default Windows: %APPDATA%\ai-video-editor\cache (typically C:\Users\[username]\AppData\Roaming\ai-video-editor\cache)
# Default macOS:   ~/Library/Caches/ai-video-editor
# Default Linux:   ~/.cache/ai-video-editor
# Fallback:        [repository-parent]/_runtime_cache/desktop-user-data
#
# Example values:
#   Windows: C:\Users\John\Videos\VideoEditorCache
#   macOS:   ~/Videos/VideoEditorCache
#   Linux:   ~/.cache/video-editor
#
# AI_VIDEO_EDITOR_CACHE_DIR=C:\custom\cache\path

# Where converted (preview-safe) videos are stored during media import.
# Default: [repository-parent]/converted-videos
# These are MP4 files converted from your input for browser-safe playback.
#
# AI_VIDEO_EDITOR_CONVERTED_VIDEOS_DIR=D:\converted-videos


# === Tools Configuration ===

# Root directory where external tools are located (mpv, python, etc.)
# Default: [repository-root]/tools
# The app looks for: tools/mpv/mpv.exe, tools/python/, tools/ffmpeg/, etc.
#
# AI_VIDEO_EDITOR_TOOLS_DIR=C:\my-tools

# Path to mpv executable (video player).
# If not set, the app will search:
#   1. [tools-dir]/mpv/mpv.exe
#   2. C:\Program Files\MPV Player\mpv.exe (Windows)
#   3. mpv on system PATH
#
# Example:
#   AI_VIDEO_EDITOR_MPV_PATH=C:\Program Files\MPV Player\mpv.exe
#   or
#   AI_VIDEO_EDITOR_MPV_PATH=C:\custom-tools\mpv\mpv.exe

# Named pipe for mpv overlay communication (Windows only).
# Default: \\.\pipe\ai-video-editor-mpv
# Only change this if you have conflicting pipe names on your system.
#
# AI_VIDEO_EDITOR_MPV_PIPE=\\.\pipe\custom-pipe-name

# Path to Python executable (for API server, optional feature).
# If not set, the app assumes `python` or `python3` is on system PATH.
#
# Example:
#   AI_VIDEO_EDITOR_PYTHON_PATH=C:\Users\John\AppData\Local\Programs\Python\Python310\python.exe

# Path to FFmpeg executable.
# Usually managed automatically by npm (ffmpeg-static package).
# You only need to set this if using a custom FFmpeg build.
#
# Example:
#   AI_VIDEO_EDITOR_FFMPEG_PATH=C:\tools\ffmpeg\ffmpeg.exe


# === Advanced / Development ===

# Enable verbose logging in main process.
# Not yet implemented; reserved for future use.
# DEBUG=ai-video-editor:*

# API server hostname and port (when/if API is implemented).
# API_HOST=127.0.0.1
# API_PORT=8000
